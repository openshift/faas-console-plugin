#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "$0")/../hack/lib/log.sh"

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)

has_changes() {
  echo "$STAGED" | grep -qE "$1"
}

# Stash unstaged changes (and untracked files) so that checks run only
# against what is staged, not the full working tree. The trap ensures the
# stash is restored even if a check fails or the script exits early.
STASHED=false
if ! git diff --quiet || test -n "$(git ls-files --others --exclude-standard)"; then
  log::info "Stashing unstaged and untracked changes..."
  git stash push --keep-index --include-untracked --quiet
  STASHED=true
fi

unstash() {
  if [ "$STASHED" = true ]; then
    log::info "Restoring unstaged changes..."
    git stash pop --quiet || log::warn "Failed to restore stash; recover with 'git stash pop'"
  fi
}
trap unstash EXIT

log::step "Running pre-commit checks"

if has_changes '^(src|e2e)/'; then
  log::info "Linting frontend..."
  make lint-frontend

  log::info "Type-checking..."
  make type-check
else
  log::info "No frontend changes, skipping lint and type-check"
fi

if has_changes '^backend/'; then
  log::info "Linting backend..."
  make lint-backend
else
  log::info "No backend changes, skipping backend lint"
fi

if has_changes '^(src/|locales/|i18next|yarn\.lock|package\.json)'; then
  log::info "Verifying i18n and deduplication..."
  make verify
else
  log::info "No i18n/dependency changes, skipping verify"
fi

log::step "Pre-commit checks passed"
