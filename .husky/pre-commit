#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "$0")/../hack/lib/log.sh"

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)

has_changes() {
  echo "$STAGED" | grep -qE "$1"
}

# Export the staged index to a temp directory so that lint/type-check run
# only against what is staged, without touching the working tree.
# This avoids the failure modes of "git stash --keep-index" (lost merge
# state, conflicts from adjacent hunks, dirty files from make verify).
STAGED_DIR="$(mktemp -d)"
trap 'rm -rf "$STAGED_DIR"' EXIT

git checkout-index --all --prefix="$STAGED_DIR/"
ln -s "$PWD/node_modules" "$STAGED_DIR/node_modules"

in_staged() { make -C "$STAGED_DIR" -o node_modules/.yarn-state.yml "$@"; }

log::step "Running pre-commit checks"

if has_changes '^(src|e2e)/'; then
  log::info "Linting frontend..."
  in_staged lint-frontend

  log::info "Type-checking..."
  in_staged type-check
else
  log::info "No frontend changes, skipping lint and type-check"
fi

if has_changes '^backend/'; then
  log::info "Linting backend..."
  in_staged lint-backend
else
  log::info "No backend changes, skipping backend lint"
fi

if has_changes '^(src/|locales/|i18next|yarn\.lock|package\.json)'; then
  log::info "Verifying i18n and deduplication..."
  make verify
else
  log::info "No i18n/dependency changes, skipping verify"
fi

log::step "Pre-commit checks passed"
