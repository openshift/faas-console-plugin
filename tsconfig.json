{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2021",
    "sourceMap": true,
    "jsx": "react-jsx",
    "allowJs": true,
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "types": [
      "vitest/globals"
    ]
  },
  "include": [
    "src",
    "testing",
    "config/i18next"
  ],
  "exclude": [
    "node_modules"
  ]
}
