{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>konflux-ci/mintmaker//config/renovate/renovate.json",
    "config:best-practices"
  ],
  "enabledManagers": ["tekton", "gomod", "npm", "dockerfile"],
  "timezone": "UTC",
  "schedule": ["before 7am"],
  "minimumReleaseAge": "90 days",
  "lockFileMaintenance": {
    "enabled": true
  },
  "gomod": {
    "packageRules": [
      {
        "matchUpdateTypes": ["major"],
        "enabled": false
      },
      {
        "matchPackageNames": ["k8s.io/*", "sigs.k8s.io/*", "knative.dev/*"],
        "matchUpdateTypes": ["major", "minor"],
        "enabled": false
      },
      {
        "matchPackageNames": ["knative.dev/*"],
        "matchUpdateTypes": ["digest"],
        "enabled": false
      },
      {
        "description": "Let the module graph pick indirect deps; bumping them alone breaks the build. CVE fixes still land via vulnerabilityAlerts.",
        "matchDepTypes": ["indirect"],
        "enabled": false
      },
      {
        "description": "Bump the go directive deliberately, in step with the go-toolset builder image.",
        "matchDatasources": ["golang-version"],
        "enabled": false
      }
    ]
  },
  "packageRules": [
    {
      "groupName": "nodejs",
      "matchManagers": ["npm"]
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "groupName": "patternfly",
      "matchPackageNames": ["@patternfly/*"]
    },
    {
      "matchPackageNames": ["@patternfly/*"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "groupName": "console-sdk",
      "matchPackageNames": [
        "@openshift-console/dynamic-plugin-sdk",
        "@openshift-console/dynamic-plugin-sdk-webpack"
      ]
    },
    {
      "matchPackageNames": [
        "@openshift-console/dynamic-plugin-sdk",
        "@openshift-console/dynamic-plugin-sdk-webpack"
      ],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "groupName": "react",
      "matchPackageNames": [
        "react",
        "react-dom",
        "react-redux",
        "react-router",
        "react-i18next"
      ],
      "enabled": false
    },
    {
      "groupName": "gomod",
      "matchManagers": ["gomod"]
    },
    {
      "groupName": "images",
      "matchManagers": ["dockerfile"]
    },
    {
      "matchPackageNames": [
        "/^quay\\.io\\/konflux-ci\\//",
        "/^registry\\.access\\.redhat\\.com\\//",
        "/^registry\\.redhat\\.io\\//"
      ],
      "minimumReleaseAge": "0 days",
      "addLabels": [
        "ok-to-test",
        "approved",
        "lgtm"
      ]
    }
  ]
}
